; Inno Setup script for ALPACKA — Acronym Launcher: Projects And Creative Kits Automator.
;
; Built by CI on `v*` tag pushes. Invoked from the repo root:
;
;   iscc installer\alpacka.iss /DMyAppVersion=0.1.0
;
; Output: installer\Output\ALPACKA-<version>-windows-x64-setup.exe
;
; Design choices:
;   * Per-user install only (`{userpf}`, `PrivilegesRequired=lowest`) — no
;     UAC prompt. Mirrors how GitHub Desktop / VS Code / Discord install.
;     Deliberately no "install for all users" override: it put the files in
;     the elevating account's `{userpf}` but registered the install in HKLM,
;     so every later install on the machine silently reused that account's
;     folder — even after the account was deleted. Per-user only, Setup
;     looks for a previous install in the current user's HKCU alone.
;   * AppId is a pinned GUID — never regenerate. It's what Inno uses to
;     detect an existing install and upgrade it in place. Changing it
;     would make every future release look like a brand-new product.
;   * Installer + uninstaller icons use the same `alpacka.ico` we ship with
;     the app, so the Add/Remove Programs row has the right branding.
;   * `{app}` folder is removed on uninstall but `%APPDATA%\ALPACKA\` (user
;     settings + projects.db) intentionally survives. Uninstall = remove
;     the binaries; leave user data alone.

#define MyAppName "ALPACKA"
#define MyAppPublisher "Acronym"
#define MyAppURL "https://github.com/acronym-lol/acro-alpacka"
#define MyAppExeName "ALPACKA.exe"

; Version is passed in from CI via /DMyAppVersion=0.1.0. Fallback lets a
; maintainer smoke-test the installer locally without supplying it.
#ifndef MyAppVersion
  #define MyAppVersion "0.0.0-dev"
#endif

[Setup]
AppId={{928D3EA7-C282-4066-995E-A6B0CC034E98}}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}/issues
AppUpdatesURL={#MyAppURL}/releases
DefaultDirName={userpf}\{#MyAppName}
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
OutputBaseFilename=ALPACKA-{#MyAppVersion}-windows-x64-setup
OutputDir=Output
SetupIconFile=..\src\alpacka\resources\icons\alpacka.ico
UninstallDisplayIcon={app}\{#MyAppExeName}
UninstallDisplayName={#MyAppName} {#MyAppVersion}
WizardStyle=modern
; Welcome + Finish banner (tall) and the small header badge on interior
; pages. Each line is a comma-separated list of assets generated by
; scripts/generate_icons.py — 100% base plus 150% and 200% for HiDPI.
; Inno Setup picks the nearest match at runtime. Inno doesn't support
; dark-mode theming, so the BMPs are the Acronym black logomark on a
; white background — matches the wizard's light chrome cleanly.
WizardImageFile=assets\wizard-banner-100.bmp,assets\wizard-banner-150.bmp,assets\wizard-banner-200.bmp
WizardSmallImageFile=assets\wizard-header-100.bmp,assets\wizard-header-150.bmp,assets\wizard-header-200.bmp
Compression=lzma2/max
SolidCompression=yes
ArchitecturesInstallIn64BitMode=x64
ArchitecturesAllowed=x64
CloseApplications=yes
RestartApplications=no

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "Create a &desktop shortcut"; GroupDescription: "Additional icons:"; Flags: unchecked

[Files]
Source: "..\dist\ALPACKA\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#MyAppName}}"; Flags: nowait postinstall skipifsilent
